{
  "name": "football-trivia",
  "version": "1.0.0",
  "type": "module",
  "description": "Personalized football trivia game",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "node scripts/dev-server.js",
    "test:client": "playwright test",
    "db:apply": "node scripts/ingest/lib/db.js --apply",
    "ingest:all": "node scripts/ingest/fetch.js && node scripts/ingest/load.js && node scripts/ingest/derive.js && node scripts/ingest/validate.js",
    "validate": "node scripts/ingest/validate.js --strict",
    "fixtures": "node scripts/ingest/export-pool.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:serve": "node scripts/prepare-functions.mjs && node scripts/serve-functions.js",
    "supabase:sync": "node scripts/supabase-sync.js",
    "supabase:serve:edge": "supabase functions serve --env-file supabase/.env.local",
    "supabase:upload": "node scripts/upload-pool.js",
    "publish": "node scripts/publish-static.mjs",
    "supabase:deploy": "node scripts/prepare-functions.mjs && supabase functions deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@supabase/supabase-js": "^2.118.0",
    "csv-parse": "^5.6.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
